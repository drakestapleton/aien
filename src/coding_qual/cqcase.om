note ======== REAL cases (own model on 127.0.0.1:PORT) ========

fn r_obs cb edit uchar 8192 cv edit ulong 32 jb edit uchar 1048576 nm view uchar * sc ulong to void
b = new uchar 256 0
p = rc_cat b 0 tobs
p = rc_cat b p nm
p = rc_cat b p tost
p = rc_dec b p cx_term cb cv jb
p = rc_cat b p tosd
p = rc_dec b p cx_jc cb cv jb kD
p = rc_cat b p tosr
p = rc_dec b p cx_jc cb cv jb kR
p = rc_cat b p toj
if cx_judge cb cv jb sc
p = rc_cat b p tojp
else
p = rc_cat b p tojf
end
p = rc_byte b p 10
rc_out view part b 0 p
end


fn r_plain cb edit uchar 8192 cv edit ulong 32 jb edit uchar 1048576 nm view uchar * sc ulong to void
cx_begin cb cv nm
x = cx_chk cv cx_setup cb cv jb sc 1
rc = cx_run cb cv 601
x = cx_chk cv eq rc 0 2
t = cx_term cb cv jb
x = cx_chk cv or or eq t 1 eq t 3 eq t 4 3
x = cx_chk cv eq cx_ver cb cv jb 0 4
r_obs cb cv jb nm sc
cx_end cv nm
end

fn r3 cb edit uchar 8192 cv edit ulong 32 jb edit uchar 1048576 to void
cx_begin cb cv m3
x = cx_chk cv cx_setup cb cv jb 2 1
pid = cx_cqa cb cv 601
x = cx_chk cv cx_poll cb cv jb ki1 120000 2
z = sleepns 2000000000
x = cx_chk cv eq cx_cancel cb cv 0 3
rc = cx_wait pid
x = cx_chk cv eq rc 0 4
t = cx_term cb cv jb
x = cx_chk cv or eq t 2 eq t 4 5
x = cx_chk cv eq cx_jc cb cv jb kE 0 6
x = cx_chk cv eq cx_ver cb cv jb 0 7
r_obs cb cv jb m3 2
cx_end cv m3
end

fn r4 cb edit uchar 8192 cv edit ulong 32 jb edit uchar 1048576 to void
cx_begin cb cv m4
x = cx_chk cv cx_setup cb cv jb 1 1
pid = cx_cqa cb cv 601
x = cx_chk cv cx_poll cb cv jb ki1 120000 2
z = sleepns 2000000000
k = killpid int pid 9
rc = cx_wait pid
x = cx_chk cv eq rc 1009 3
x = cx_chk cv eq cx_jc cb cv jb kr1 0 4
r2 = cx_run cb cv 602
x = cx_chk cv eq r2 0 5
t = cx_term cb cv jb
x = cx_chk cv or or eq t 1 eq t 3 eq t 4 6
x = cx_chk cv le cx_jc cb cv jb kr1 1 7
x = cx_chk cv eq cx_ver cb cv jb 0 8
r_obs cb cv jb m4 1
cx_end cv m4
end

fn cx_real cb edit uchar 8192 cv edit ulong 32 jb edit uchar 1048576 to void
r_plain cb cv jb m1 1
r_plain cb cv jb m2 2
r3 cb cv jb
r4 cb cv jb
end

note ======== main ========

fn cx_arg cb edit uchar 8192 cv edit ulong 32 i ulong ds ulong slot ulong to bool
n = rc_arg i part cb ds 1000
if lt n 1
ret false
end
put cv slot ulong n
ret true
end

fn cx_sum cv edit ulong 32 to int
b = new uchar 128 0
p = rc_cat b 0 tsum1
if eq get cv 8 1
p = rc_cat b p tsynl
else
p = rc_cat b p treall
end
if eq get cv 7 0
p = rc_cat b p tsum2
p = rc_dec b p get cv 6
p = rc_byte b p 10
rc_out view part b 0 p
ret 0
end
p = rc_cat b p tsum3
p = rc_dec b p get cv 7
p = rc_cat b p tsum4
p = rc_dec b p get cv 6
p = rc_byte b p 10
rc_out view part b 0 p
ret 1
end

fn main to int
cb = new uchar 8192 0
cv = new ulong 32 0
jb = new uchar 1048576 0
mb = new uchar 16 0
n = rc_arg 1 mb
na = ulong argcnt
if lt n 1
rc_out tusage
ret 2
end
if rc_is mb 0 ulong n tsyn
put cv 8 1
end
if rc_is mb 0 ulong n trl
put cv 8 2
end
if or eq get cv 8 0 lt na 6
rc_out tusage
ret 2
end
a1 = cx_arg cb cv 2 0 0
a2 = cx_arg cb cv 3 1024 1
a3 = cx_arg cb cv 4 2048 2
a4 = cx_arg cb cv 5 3072 3
if not and and a1 a2 and a3 a4
rc_out tusage
ret 2
end
mk = makedir cb 1024 get cv 1 448
if eq get cv 8 1
cx_synth cb cv jb
ret cx_sum cv
end
if lt na 7
rc_out tusage
ret 2
end
a5 = cx_arg cb cv 6 4096 4
cx_real cb cv jb
ret cx_sum cv
end
