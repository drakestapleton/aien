note c4same: the request re-sent after the kill (4) carries the same body as the killed one (3).
fn c4same cb edit uchar 8192 cv edit ulong 32 jb edit uchar 1048576 to bool
k = cx_rd cb cv jb tfixo
a = rc_find jb 0 k kf3
b = rc_find jb 0 k kf4
if or ge a k ge b k
ret false
end
ea = cx_eol jb a k
eb = cx_eol jb b k
if ne sub ea a sub eb b
ret false
end
ret c4eq jb add a 5 add b 5 sub ea add a 5
end

fn c4eq jb edit uchar 1048576 a ulong b ulong n ulong to bool
for i ulong n
if ne get jb add a i get jb add b i
ret false
end
end
ret true
end


fn cx_eol jb edit uchar 1048576 a ulong k ulong to ulong
e = add a 1
while lt e k bound 1048577
if eq get jb e 10
ret e
end
e = add e 1
end
ret k
end

note c_crash: c5 (crash=E) and c6 (crash=W): exit 77 inside the first write, resume, one D.
fn c_crash cb edit uchar 8192 cv edit ulong 32 jb edit uchar 1048576 nm view uchar * oc ulong to void
cx_begin cb cv nm
x = cx_chk cv cx_setup cb cv jb 1 1
x = cx_chk cv cx_fix cb cv jb sc1 2
rc = cx_run cb cv add 801 mul oc 10
x = cx_chk cv eq rc 77 3
x = cx_chk cv eq cx_jc cb cv jb ke3 1 4
x = cx_chk cv eq cx_jc cb cv jb kd3 0 5
r2 = cx_run cb cv 802
x = cx_chk cv eq r2 0 6
x = cx_chk cv eq cx_term cb cv jb 1 7
x = cx_chk cv eq cx_jc cb cv jb kd3 1 8
x = cx_chk cv eq cx_ver cb cv jb 0 9
x = cx_chk cv eq cx_cnt cb cv jb 1 kf6 1 10
x = cx_chk cv eq cx_cnt cb cv jb 1 kf7 0 11
x = cx_chk cv cx_judge cb cv jb 1 12
cx_end cv nm
end

