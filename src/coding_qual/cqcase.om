global pk uchar 4096
global pkn ulong 2

note ======== packets and processes ========

fn pk_reset to void
put pkn 0 2
put pkn 1 0
put pk 0 0
put pk 1 0
end

fn pk_add a view uchar * to void
n = get pkn 0
m = len a
if gt add add n 2 m 4096
trap 3
end
put pk n uchar and m 255
put pk add n 1 uchar shr m 8
for i ulong m
put pk add add n 2 i get a i
end
put pkn 0 add add n 2 m
c = add get pkn 1 1
put pkn 1 c
put pk 0 uchar and c 255
put pk 1 uchar shr c 8
end

note cx_spawn: fork; the child changes to cb[co, co + cn) when cn > 0, writes stdout and stderr to
note cb[oo, oo + on) and execs pk. The pid or a negative result.
fn cx_spawn cb edit uchar 8192 co ulong cn ulong oo ulong on ulong to long
pid = fork
if lt pid 0
ret pid
end
if eq pid 0
if gt cn 0
z = chdir cb co cn
if lt z 0
exit 126
end
end
fd = fopen cb oo on 524865 384
if ge fd 0
d = dupfd int fd 1 0
d = dupfd int fd 2 0
end
r = execprog pk 0 get pkn 0
exit 127
end
ret pid
end

note cx_wait: exit status, 1000 + signal when killed.
fn cx_wait pid long to long
st = new uchar 4 0
r = waitpid int pid st 0 4 0
if lt r 0
ret r
end
s = or or ulong get st 0 shl ulong get st 1 8 shl ulong get st 2 16
if eq and s 127 0
ret long and shr s 8 255
end
ret long add 1000 and s 127
end

note ======== paths in cb: BIN [0), WORK [1024), BASE [2048), JUDGES [3072), port text [4096),
note case name [4160), nonce [4224); builders PA [5120), PB [6144), PC [7168). cv lengths 0..5.

const PA ulong 5120
const PB ulong 6144
const PC ulong 7168

fn cx_put cb edit uchar 8192 p ulong t view uchar * to ulong
q = p
for i ulong len t
put cb q get t i
q = add q 1
end
ret q
end

fn cx_cp cb edit uchar 8192 p ulong s ulong n ulong to ulong
q = p
for i ulong n bound 1024
put cb q get cb add s i
q = add q 1
end
ret q
end

note cx_pw: WORK/<case><sfx> into builder at; its length.
fn cx_pw cb edit uchar 8192 cv edit ulong 32 ds ulong sfx view uchar * to ulong
p = cx_cp cb ds 1024 get cv 1
p = cx_put cb p tsl
p = cx_cp cb p 4160 get cv 5
p = cx_put cb p sfx
ret sub p ds
end

fn cx_pb cb edit uchar 8192 cv edit ulong 32 ds ulong sfx view uchar * to ulong
p = cx_cp cb ds 0 get cv 0
p = cx_put cb p tsl
p = cx_put cb p sfx
ret sub p ds
end

fn cx_pj cb edit uchar 8192 cv edit ulong 32 ds ulong sfx view uchar * to ulong
p = cx_cp cb ds 3072 get cv 3
p = cx_put cb p tsl
p = cx_put cb p sfx
ret sub p ds
end

note cx_wr: t into the file WORK/<case><sfx> (created, truncated).
fn cx_wr cb edit uchar 8192 cv edit ulong 32 sfx view uchar * t view uchar * to long
n = cx_pw cb cv PC sfx
fd = fopen cb PC n 524865 420
if lt fd 0
ret fd
end
r = rc_wall int fd t len t
c = fclose int fd
ret r
end

note cx_rd: the file WORK/<case><sfx> into jb; its length (0 when absent).
fn cx_rd cb edit uchar 8192 cv edit ulong 32 jb edit uchar 1048576 sfx view uchar * to ulong
n = cx_pw cb cv PC sfx
r = rc_read view part cb PC n jb
if lt r 0
ret 0
end
ret ulong r
end

note ======== case setup ========

note cx_name: set the case name (its first word) for paths.
fn cx_name cb edit uchar 8192 cv edit ulong 32 nm view uchar * to void
k = ulong 0
for i ulong len nm bound 60
if eq get nm i 32
break
end
put cb add 4160 i get nm i
k = add k 1
end
put cv 5 k
end

note cx_setup: WORK/<case> with an isolated worktree of branch cq-s<sc> and the task files.
fn cx_setup cb edit uchar 8192 cv edit ulong 32 jb edit uchar 1048576 sc ulong to bool
n = cx_pw cb cv PA tnc
r = makedir cb PA n 448
if lt r 0
ret false
end
m = cx_pw cb cv PA trepo
pk_reset
pk_add tgit
pk_add tgc
pk_add view part cb 2048 get cv 2
pk_add twt
pk_add tadd
pk_add tqq
pk_add tdet
pk_add view part cb PA m
if eq sc 1
pk_add tbr1
else
pk_add tbr2
end
o = cx_pw cb cv PB twto
pid = cx_spawn cb 0 0 PB o
if lt pid 0
ret false
end
if ne cx_wait pid 0
ret false
end
if eq sc 1
r = cx_wr cb cv tiss is1
r = cx_wr cb cv town ow1
else
r = cx_wr cb cv tiss is2
r = cx_wr cb cv town ow2
end
ret cx_test cb cv
end


note cx_test: test.txt = bwrap (no network, read-only, private /tmp) python3 -B -m unittest discover.
fn cx_test cb edit uchar 8192 cv edit ulong 32 to bool
b = new uchar 4096 0
m = cx_pw cb cv PA trepo
p = rc_cat b 0 tbw
p = rc_byte b p 10
p = rc_cat b p tbwa
p = cx_ln b p cb PA m
p = cx_ln b p cb PA m
p = rc_cat b p tbwb
p = cx_ln b p cb PA m
p = rc_cat b p tbwc
r = cx_wr cb cv ttst view part b 0 p
ret ge r 0
end

fn cx_ln b edit uchar 4096 p ulong cb view uchar 8192 o ulong n ulong to ulong
q = p
for i ulong n bound 1024
put b q get cb add o i
q = add q 1
end
put b q 10
ret add q 1
end

note ======== scripts and the fixture ========

note cx_blk: the expansion of @d into b at p.
fn cx_blk b edit uchar 1048576 p ulong d uchar to ulong
q = rc_cat b p tpyo
if eq d 49
q = rc_cat b q bnorm1
end
if eq d 50
q = rc_cat b q bword1
end
if eq d 51
q = rc_cat b q bword2
end
if eq d 52
q = rc_cat b q bjunk
end
ret rc_cat b q tfence
end

note cx_rec: one script record s[a, e) (MS^CONTENT) as a cqfix line onto o at p.
fn cx_rec s view uchar * a ulong e ulong o edit uchar 1048576 p ulong to ulong
h = a
while lt h e bound 65536
if eq get s h 94
break
end
h = add h 1
end
if eq get s a 88
q = rc_byte o p 69
q = rc_byte o q 32
q = rc_byte o q 48
q = rc_byte o q 32
q = rc_byte o q 99
q = rc_byte o q 116
q = rc_byte o q 120
ret rc_byte o q 10
end
q = rc_byte o p 67
q = rc_byte o q 32
for i ulong sub h a bound 16
q = rc_byte o q get s add a i
end
q = rc_byte o q 32
ct = new uchar 65536 0
cn = cx_exp s add h 1 e ct
q = rc_hex o q view part ct 0 cn
ret rc_byte o q 10
end

fn cx_exp s view uchar * a ulong e ulong ct edit uchar 65536 to ulong
x = new uchar 1048576 0
w = ulong 0
i = a
while lt i e bound 65536
c = get s i
if and eq c 64 lt add i 1 e
w = cx_blk x w get s add i 1
i = add i 2
else
put x w c
w = add w 1
i = add i 1
end
end
for j ulong w bound 65536
put ct j get x j
end
ret w
end

note cx_script: the cqfix script for scenario text s into WORK/<case>.script.
fn cx_script cb edit uchar 8192 cv edit ulong 32 s view uchar * to long
o = new uchar 1048576 0
p = ulong 0
a = ulong 0
while lt a len s bound 64
e = a
while lt e len s bound 65536
if eq get s e 126
break
end
e = add e 1
end
p = cx_rec s a e o p
a = add e 1
end
ret cx_wr cb cv tscr view part o 0 p
end

note cx_fix: start cqfix on the case script; its port text into cb[4096) (cv 4), pid cv 9.
fn cx_fix cb edit uchar 8192 cv edit ulong 32 jb edit uchar 1048576 s view uchar * to bool
r = cx_script cb cv s
if lt r 0
ret false
end
pk_reset
n = cx_pb cb cv PA tfixb
pk_add view part cb PA n
m = cx_pw cb cv PB tscr
pk_add view part cb PB m
pk_add t64
o = cx_pw cb cv PC tfixo
pid = cx_spawn cb 0 0 PC o
if lt pid 0
ret false
end
put cv 9 ulong pid
for i ulong 400
z = sleepns 10000000
k = cx_rd cb cv jb tfixo
if gt k 6
if cx_port cb cv jb k
ret true
end
end
end
ret false
end

fn cx_port cb edit uchar 8192 cv edit ulong 32 jb edit uchar 1048576 k ulong to bool
if not rc_is jb 0 5 tport
ret false
end
n = ulong 0
for i ulong sub k 5 bound 8
c = get jb add 5 i
if or lt c 48 gt c 57
break
end
put cb add 4096 i c
n = add n 1
end
put cv 4 n
ret gt n 0
end

fn cx_stopfix cv edit ulong 32 to void
if gt get cv 9 0
x = killpid int long get cv 9 9
y = cx_wait long get cv 9
put cv 9 0
end
end

note ======== running cqa ========

note cx_cqa: start `cqa task WORK/<case> PORT steps=S [crash=E|W]` with output WORK/<case>.outK;
note md = S * 100 + C * 10 + K (S 8, 6 or 3; C 0 none, 1 crash=E, 2 crash=W; K 1..3). The pid.
fn cx_cqa cb edit uchar 8192 cv edit ulong 32 md ulong to long
pk_reset
n = cx_pb cb cv PA tcqa
pk_add view part cb PA n
pk_add ttask
m = cx_pw cb cv PB tnc
pk_add view part cb PB m
pk_add view part cb 4096 get cv 4
s = div md 100
if eq s 8
pk_add tst8
end
if eq s 6
pk_add tst6
end
if eq s 3
pk_add tst3
end
c = rem div md 10 10
if eq c 1
pk_add tcrE
end
if eq c 2
pk_add tcrW
end
k = rem md 10
o = cx_pw cb cv PC tout1
if eq k 2
o = cx_pw cb cv PC tout2
end
ret cx_spawn cb 0 0 PC o
end

fn cx_run cb edit uchar 8192 cv edit ulong 32 md ulong to long
pid = cx_cqa cb cv md
if lt pid 0
ret pid
end
ret cx_wait pid
end

fn cx_cancel cb edit uchar 8192 cv edit ulong 32 to long
pk_reset
n = cx_pb cb cv PA tcqa
pk_add view part cb PA n
pk_add tcanc
m = cx_pw cb cv PB tnc
pk_add view part cb PB m
o = cx_pw cb cv PC tout3
pid = cx_spawn cb 0 0 PC o
if lt pid 0
ret pid
end
ret cx_wait pid
end

note cx_poll: wait until the journal holds nd (at most ms milliseconds).
fn cx_poll cb edit uchar 8192 cv edit ulong 32 jb edit uchar 1048576 nd view uchar * ms ulong to bool
for i ulong div ms 20 bound 999999
k = cx_rd cb cv jb tjrn
if lt rc_find jb 0 k nd k
ret true
end
z = sleepns 20000000
end
ret false
end

note cx_cnt: occurrences of nd in the case file <sfx>.
fn cx_cnt cb edit uchar 8192 cv edit ulong 32 jb edit uchar 1048576 w ulong nd view uchar * to ulong
k = cx_rd cb cv jb tjrn
if eq w 1
k = cx_rd cb cv jb tfixo
end
c = ulong 0
p = ulong 0
while lt p k bound 1048577
i = rc_find jb p k nd
if ge i k
ret c
end
c = add c 1
p = add i 1
end
ret c
end

fn cx_jc cb edit uchar 8192 cv edit ulong 32 jb edit uchar 1048576 nd view uchar * to ulong
ret cx_cnt cb cv jb 0 nd
end

note cx_term: the T state of the journal (0 none).
fn cx_term cb edit uchar 8192 cv edit ulong 32 jb edit uchar 1048576 to ulong
k = cx_rd cb cv jb tjrn
i = rc_find jb 0 k ktn
if ge i k
ret 0
end
ret rc_num jb add i 5 1
end


note ======== verifier (independent of cqa's code) ========

note vf_line: checks one journal line jb[p, e); counts into ct (kind x 65 steps); false when malformed.
fn vf_line jb edit uchar 1048576 p ulong e ulong ct edit ulong 1040 to bool
if lt sub e p 5
ret false
end
k = get jb p
ki = vf_kind k
if eq ki 99
ret false
end
if ne get jb add p 1 32
ret false
end
q = add p 2
while lt q e bound 32
if eq get jb q 32
break
end
q = add q 1
end
s = rc_num jb add p 2 sub q add p 2
if gt s 64
ret false
end
put ct add mul ki 65 s add get ct add mul ki 65 s 1
if and eq ki 3 gt get ct 1035 0
put ct 1036 1
end
if eq ki 6
put ct 1035 1
end
ret true
end

note vf_kind: J 0, I 1, R 2, E 3, D 4, A 5, X 6, T 7, N 8, O 9, anything else 99.
fn vf_kind k uchar to ulong
if eq k 74
ret 0
end
if eq k 73
ret 1
end
if eq k 82
ret 2
end
if eq k 69
ret 3
end
if eq k 68
ret 4
end
if eq k 65
ret 5
end
if eq k 88
ret 6
end
if eq k 84
ret 7
end
if eq k 78
ret 8
end
if eq k 79
ret 9
end
ret 99
end

note cx_ver: the verifier; the failing check number (0 = PASS).
fn cx_ver cb edit uchar 8192 cv edit ulong 32 jb edit uchar 1048576 to ulong
k = cx_rd cb cv jb tjrn
if eq k 0
ret 1
end
if ne get jb sub k 1 10
ret 2
end
ct = new ulong 1040 0
p = ulong 0
while lt p k bound 1048577
e = p
while lt e k bound 1048577
if eq get jb e 10
break
end
e = add e 1
end
if not vf_line jb p e ct
ret 3
end
p = add e 1
end
r = vf_counts ct
if gt r 0
ret r
end
r2 = vf_files cb cv jb
if gt r2 0
ret r2
end
ret vf_git cb cv jb
end

fn vf_counts ct edit ulong 1040 to ulong
t = ulong 0
for s ulong 65
t = add t get ct add 455 s
if gt get ct add 130 s 1
ret 4
end
if gt get ct add 195 s 1
ret 5
end
if ne get ct add 260 s get ct add 195 s
ret 6
end
end
if ne t 1
ret 7
end
if gt get ct 1036 0
ret 8
end
ret 0
end

note vf_files: for every step s with a D, unless a later step writes the same path, the file named
note by E s must have the D's length and FNV-1a 64.
fn vf_files cb edit uchar 8192 cv edit ulong 32 jb edit uchar 1048576 to ulong
for i ulong 64
s = sub 64 i
r = vf_one cb cv jb s
if gt r 0
ret r
end
end
ret 0
end

note vf_one: step s; 0 when fine or not applicable.
fn vf_one cb edit uchar 8192 cv edit ulong 32 jb edit uchar 1048576 s ulong to ulong
k = cx_rd cb cv jb tjrn
dz = vf_find jb k 68 s
if ge dz k
ret 0
end
ez = vf_find jb k 69 s
if ge ez k
ret 9
end
pn = vf_path jb k ez cb
if eq pn 0
ret 10
end
for t ulong sub 64 s
s2 = add add s t 1
e2 = vf_find jb k 69 s2
if lt e2 k
if lt vf_find jb k 68 s2 k
if vf_same jb k e2 cb pn
ret 0
end
end
end
end
dl = vf_num jb dz 2
dh = vf_num jb dz 3
ret vf_chk cb cv jb pn dl dh
end

note vf_chk: the file WORK/<case>/repo/<cb[PB, PB + pn)> has length dl and FNV-1a 64 dh.
fn vf_chk cb edit uchar 8192 cv edit ulong 32 jb edit uchar 1048576 pn ulong dl ulong dh ulong to ulong
m = cx_pw cb cv PA trepos
q = cx_cp cb add PA m PB pn
r = rc_read view part cb PA sub q PA jb
if lt r 0
ret 11
end
if ne ulong r dl
ret 12
end
if ne vf_fnv jb ulong r dh
ret 13
end
ret 0
end

fn vf_fnv jb edit uchar 1048576 n ulong to ulong
h = ulong 14695981039346656037
for i ulong n
h = mul xor h ulong get jb i 1099511628211
end
ret h
end

note vf_find: offset of the record "K s " in jb[0, k), else k.
fn vf_find jb edit uchar 1048576 k ulong c uchar s ulong to ulong
nd = new uchar 32 0
p = rc_byte nd 0 10
p = rc_byte nd p c
p = rc_byte nd p 32
p = rc_dec nd p s
p = rc_byte nd p 32
i = rc_find jb 0 k view part nd 0 p
if ge i k
ret k
end
ret add i 1
end

note vf_fld: start of field f of the record at o.
fn vf_fld jb edit uchar 1048576 o ulong f ulong to ulong
p = o
c = ulong 0
while lt c f bound 16
while ne get jb p 32 bound 1048577
p = add p 1
end
p = add p 1
c = add c 1
end
ret p
end

fn vf_num jb edit uchar 1048576 o ulong f ulong to ulong
a = vf_fld jb o f
e = a
while and ne get jb e 32 ne get jb e 10 bound 32
e = add e 1
end
ret rc_num jb a sub e a
end

note vf_path: the hex path of the E record at o decoded into cb[PB); its length (0 bad).
fn vf_path jb edit uchar 1048576 k ulong o ulong cb edit uchar 8192 to ulong
a = vf_fld jb o 2
e = a
while and lt e k ne get jb e 10 bound 1024
e = add e 1
end
if or eq e a ne rem sub e a 2 0
ret 0
end
if gt sub e a 1024
ret 0
end
x = new uchar 512 0
m = rc_unhex jb a sub e a x
if le m 0
ret 0
end
for i ulong ulong m
put cb add PB i get x i
end
ret ulong m
end

fn vf_same jb edit uchar 1048576 k ulong o ulong cb edit uchar 8192 pn ulong to bool
x = new uchar 512 0
for i ulong pn
put x i get cb add PB i
end
n = vf_path jb k o cb
r = and eq n pn rc_same view part x 0 pn view part cb PB pn
for j ulong pn
put cb add PB j get x j
end
ret r
end

note vf_git: `git -C repo status --porcelain -uall`: every changed path is a line of own.txt.
fn vf_git cb edit uchar 8192 cv edit ulong 32 jb edit uchar 1048576 to ulong
m = cx_pw cb cv PA trepo
pk_reset
pk_add tgit
pk_add tgc
pk_add view part cb PA m
pk_add tstat
pk_add tpor
pk_add tuall
o = cx_pw cb cv PC tgito
pid = cx_spawn cb 0 0 PC o
if lt pid 0
ret 14
end
if ne cx_wait pid 0
ret 15
end
ret vf_gchk cb cv jb
end

fn vf_gchk cb edit uchar 8192 cv edit ulong 32 jb edit uchar 1048576 to ulong
ow = new uchar 4096 0
n = cx_rd cb cv jb town
for i ulong n bound 4096
put ow i get jb i
end
k = cx_rd cb cv jb tgito
p = ulong 0
while lt p k bound 4097
e = cx_eol0 jb p k
if not vf_gl view part ow 0 n jb p e
ret 16
end
p = add e 1
end
ret 0
end

fn cx_eol0 jb edit uchar 1048576 a ulong k ulong to ulong
e = a
while lt e k bound 1048577
if eq get jb e 10
ret e
end
e = add e 1
end
ret k
end

fn vf_gl ow view uchar * jb edit uchar 1048576 p ulong e ulong to bool
if lt sub e p 4
ret false
end
ret vf_own ow jb add p 3 sub e add p 3
end

fn vf_own ow view uchar * jb edit uchar 1048576 a ulong n ulong to bool
p = ulong 0
while lt p len ow bound 4097
e = p
while lt e len ow bound 4097
if eq get ow e 10
break
end
e = add e 1
end
if eq sub e p n
if rc_same view part ow p n view part jb a n
ret true
end
end
p = add e 1
end
ret false
end

note ======== judge ========

fn cx_nonce cb edit uchar 8192 cv edit ulong 32 to void
r = new uchar 12 0
x = random r 0 12 0
p = ulong 4224
for i ulong 12
c = ulong get r i
put cb p rc_hexd shr c 4
put cb add p 1 rc_hexd and c 15
p = add p 2
end
put cv 12 24
end

note cx_judge: the hidden judge of scenario sc on the case worktree; true for PASS.
fn cx_judge cb edit uchar 8192 cv edit ulong 32 jb edit uchar 1048576 sc ulong to bool
cx_nonce cb cv
m = cx_pw cb cv PA trepo
pk_reset
pk_add tbw
cx_pargs view part tbwa 0 sub len tbwa 1
pk_add view part cb PA m
pk_add view part cb PA m
pk_add view part tbwb 0 sub len tbwb 1
pk_add view part cb PA m
pk_add view part tbwc 0 2
pk_add tpy
pk_add tbB
j = cx_pj cb cv PB tjs2
if eq sc 1
j = cx_pj cb cv PB tjs1
end
pk_add view part cb PB j
pk_add view part cb 4224 24
o = cx_pw cb cv PC tjudo
pid = cx_spawn cb 0 0 PC o
if lt pid 0
ret false
end
rc = cx_wait pid
ret cx_jout cb cv jb rc
end

fn cx_jout cb edit uchar 8192 cv edit ulong 32 jb edit uchar 1048576 rc long to bool
k = cx_rd cb cv jb tjudo
nd = new uchar 26 0
put nd 0 10
for i ulong 24
put nd add i 1 get cb add 4224 i
end
put nd 25 10
f = rc_find jb 0 k view part nd 0 26
f0 = false
if ge k 25
f0 = rc_same view part jb 0 25 view part nd 1 25
end
ret and eq rc 0 or lt f k f0
end

note cx_pargs: every newline-separated word of t as a packet argument.
fn cx_pargs t view uchar * to void
p = ulong 0
while lt p len t bound 4097
e = p
while lt e len t bound 4097
if eq get t e 10
break
end
e = add e 1
end
pk_add view part t p sub e p
p = add e 1
end
end

note ======== results ========

fn cx_res cv edit ulong 32 nm view uchar * ok bool step ulong to bool
b = new uchar 160 0
p = rc_cat b 0 tcase
p = rc_cat b p nm
if ok
p = rc_cat b p tpass
else
p = rc_cat b p tfail
p = rc_dec b p step
p = rc_byte b p 10
put cv 7 add get cv 7 1
end
put cv 6 add get cv 6 1
rc_out view part b 0 p
ret ok
end

note cx_chk: record the first failing step k when ok is false.
fn cx_chk cv edit ulong 32 ok bool k ulong to bool
if not ok
if eq get cv 11 0
put cv 11 k
end
end
ret ok
end

fn cx_begin cb edit uchar 8192 cv edit ulong 32 nm view uchar * to void
cx_name cb cv nm
put cv 11 0
end

fn cx_end cv edit ulong 32 nm view uchar * to void
st = get cv 11
cx_stopfix cv
x = cx_res cv nm eq st 0 st
end

note ======== SYNTHETIC cases ========

note c_ref: setup scenario sc, run the reference script s to DONE; checks numbered from 1.
fn c_ref cb edit uchar 8192 cv edit ulong 32 jb edit uchar 1048576 sc ulong s view uchar * to bool
x = cx_chk cv cx_setup cb cv jb sc 1
x = cx_chk cv cx_fix cb cv jb s 2
rc = cx_run cb cv 801
ret cx_chk cv eq rc 0 3
end

