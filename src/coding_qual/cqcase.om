text n12 "c12 verifier-negative-control"
text n13 "c13 torn-journal-tail-resume"
text ttorn "D 3 24"
text m1 "r1 real-cross-file-change"
text m2 "r2 real-failing-test"
text m3 "r3 real-cancel-mid-task"
text m4 "r4 real-resume-after-sigkill"
