cx_end cv n11
end

note cx_setup2: the S1 judge on an unmodified S1 worktree must fail too (c11 runs both judges).
fn cx_setup2 cb edit uchar 8192 cv edit ulong 32 jb edit uchar 1048576 to bool
cx_name cb cv n11b
if not cx_setup cb cv jb 1
ret false
end
ret not cx_judge cb cv jb 1
end


fn c12 cb edit uchar 8192 cv edit ulong 32 jb edit uchar 1048576 to void
cx_begin cb cv n12
x = c_ref cb cv jb 1 sc1
x = cx_chk cv eq cx_ver cb cv jb 0 4
x = cx_chk cv c12tamp cb cv jb tnorm 5
x = cx_chk cv ne cx_ver cb cv jb 0 6
x = cx_chk cv c12undo cb cv jb 7
x = cx_chk cv eq cx_ver cb cv jb 0 8
x = cx_chk cv c12tamp cb cv jb tstray 9
x = cx_chk cv eq cx_ver cb cv jb 16 10
cx_end cv n12
end

note c12tamp: append one byte to WORK/<case><sfx> (created when absent).
fn c12tamp cb edit uchar 8192 cv edit ulong 32 jb edit uchar 1048576 sfx view uchar * to bool
n = cx_pw cb cv PC sfx
r = rc_append view part cb PC n tx 1
ret eq r 0
end

fn c12undo cb edit uchar 8192 cv edit ulong 32 jb edit uchar 1048576 to bool
k = cx_rd cb cv jb tnorm
if eq k 0
ret false
end
n = cx_pw cb cv PC tnorm
fd = fopen cb PC n 524865 420
if lt fd 0
ret false
end
r = rc_wall int fd jb sub k 1
c = fclose int fd
ret eq r 0
end

note c13: a torn journal tail (a partial D line without its newline, as a crash mid-append leaves
note it) is cut on restart and the effect is recorded once, well-formed.
fn c13 cb edit uchar 8192 cv edit ulong 32 jb edit uchar 1048576 to void
cx_begin cb cv n13
x = cx_chk cv cx_setup cb cv jb 1 1
x = cx_chk cv cx_fix cb cv jb sc1 2
rc = cx_run cb cv 811
x = cx_chk cv eq rc 77 3
n = cx_pw cb cv PC tjrn
r = rc_append view part cb PC n ttorn len ttorn
x = cx_chk cv eq r 0 4
r2 = cx_run cb cv 802
x = cx_chk cv eq r2 0 5
x = cx_chk cv eq cx_term cb cv jb 1 6
x = cx_chk cv eq cx_jc cb cv jb kd3 1 7
x = cx_chk cv eq cx_ver cb cv jb 0 8
x = cx_chk cv cx_judge cb cv jb 1 9
cx_end cv n13
end

